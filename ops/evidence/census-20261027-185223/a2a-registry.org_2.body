e" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github h-5 w-5" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg></a><a href="/auth/login"><button data-slot="button" data-variant="ghost" data-size="sm" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-8 rounded-md gap-1.5 px-3 has-[&gt;svg]:px-2.5 text-gray-500 hover:text-gray-900">Log in</button></a><a href="/auth/signup"><button data-slot="button" data-variant="default" data-size="sm" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground hover:bg-primary/90 h-8 rounded-md gap-1.5 px-3 has-[&gt;svg]:px-2.5">Sign up</button></a></div></div></header><main class="flex-1 "><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"A2A Registry","alternateName":"Global A2A Registry","url":"https://www.a2a-registry.org","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.a2a-registry.org/browse?q={search_term_string}"},"query-input":"required name=search_term_string"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the Global A2A Registry?","acceptedAnswer":{"@type":"Answer","text":"The open, public directory for AI agents that speak the Agent-to-Agent (A2A) Protocol. Think of it as the DNS of the agentic web: a neutral place where agents are listed, verified, and discoverable by humans and machines alike."}},{"@type":"Question","name":"How is this different from AWS, Google, or Microsoft agent registries?","acceptedAnswer":{"@type":"Answer","text":"Cloud-vendor registries (AWS Agent Registry in Bedrock AgentCore, Google Agent Registry, Microsoft Entra Agent ID) govern internal enterprise fleets inside their own platforms. The Global A2A Registry is the neutral public layer: list once and be discoverable by anyone on the open web — no cloud account, no IAM setup. Many organizations use both side by side. (Facts last checked August 2026.)"}},{"@type":"Question","name":"How much does it cost to list an agent?","acceptedAnswer":{"@type":"Answer","text":"Nothing. Listing is free forever — the registry is community-driven open infrastructure."}},{"@type":"Question","name":"Do I need an account to list my agent?","acceptedAnswer":{"@type":"Answer","text":"No. Paste your agent URL on the submit page and we auto-discover the details from your agent card, website, GitHub repo, or GoDaddy ANS name. You only need a free account to claim an agent, manage it, or earn the verified badge."}},{"@type":"Question","name":"How does verification work?","acceptedAnswer":{"@type":"Answer","text":"Three ways, all simple: businesses add one DNS TXT record to their domain; individual developers link their GitHub account; existing GoDaddy ANS names are detected automatically during submission."}},{"@type":"Question","name":"Can AI agents discover listings automatically?","acceptedAnswer":{"@type":"Answer","text":"Yes. The registry itself is an A2A-compliant agent: fetch its card at /.well-known/agent-card.json, then send natural-language queries to POST /a2a/discover to find and call registered agents — zero hardcoded endpoints."}}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":"Featured A2A agents","itemListElement":[{"@type":"ListItem","position":1,"url":"https://www.a2a-registry.org/agent/uk.co.algovoi.algovoi_payment_agent","name":"AlgoVoi Payment Agent"},{"@type":"ListItem","position":2,"url":"https://www.a2a-registry.org/agent/com.warppay402.warppay402_gateway","name":"WarpPay402 MCP Gateway"},{"@type":"ListItem","position":3,"url":"https://www.a2a-registry.org/agent/io.asterpay.asterpay","name":"AsterPay"},{"@type":"ListItem","position":4,"url":"https://www.a2a-registry.org/agent/uk.co.algovoi.algovoi_payable_rail","name":"AlgoVoi Payable Rail"},{"@type":"ListItem","position":5,"url":"https://www.a2a-registry.org/agent/com.backtestmarket.backtestmarket_agent","name":"BacktestMarket Agent"},{"@type":"ListItem","position":6,"url":"https://www.a2a-registry.org/agent/dev.dualregistry.scro_orphan_desk","name":"Scro Orphan Desk"},{"@type":"ListItem","position":7,"url":"https://www.a2a-registry.org/agent/dev.agentgalaxy.agent_galaxy_directory","name":"Agent Galaxy Directory"},{"@type":"ListItem","position":8,"url":"https://www.a2a-registry.org/agent/github.livastic_vm3_primary_tmp_260920.vm3_usdc_receipt_qa","name":"VM3 Public USDC Receipt Evidence QA"},{"@type":"ListItem","position":9,"url":"https://www.a2a-registry.org/agent/io.agentsvc.agentsvcio","name":"agentsvc.io"},{"@type":"ListItem","position":10,"url":"https://www.a2a-registry.org/agent/dev.workers.agent_exchange","name":"Agent Exchange"},{"@type":"ListItem","position":11,"url":"https://www.a2a-registry.org/agent/work.agentexchange.agent_planets","name":"Agent Planets"},{"@type":"ListItem","position":12,"url":"https://www.a2a-registry.org/agent/com.babyblueviper.invinoveritas_reasoning_agent","name":"invinoveritas-reasoning-agent"}]}</script><section class="relative overflow-hidden py-14 lg:py-16 bg-background"><div class="absolute inset-0 overflow-hidden pointer-events-none"><div class="absolute -top-[20%] left-[10%] w-[50%] h-[60%] rounded-[100%] bg-blue-500/8 blur-[100px]"></div><div class="absolute top-[30%] -right-[10%] w-[40%] h-[50%] rounded-[100%] bg-indigo-500/6 blur-[100px]"></div></div><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center"><div class="mb-5 inline-flex items-center rounded-full border border-blue-200 px-4 py-1.5 text-sm bg-blue-50 text-blue-700 font-medium"><span class="flex h-2 w-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span><span>The Global Directory &amp; Registry for the Agentic Web</span></div><h1 class="mb-6 text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl">The Global<!-- --> <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600">A2A Registry</span><br/>for the Agentic Web</h1><p class="mb-7 max-w-4xl text-lg text-muted-foreground sm:text-xl leading-relaxed">The definitive <strong>AI agent directory</strong> and <strong>registry</strong> for the <strong>Agentic Web</strong>. Discover, verify, and orchestrate autonomous AI agents using the A2A Protocol.</p><form class="relative w-full max-w-3xl mx-auto mb-4 shadow-xl hover:shadow-2xl transition-all duration-300 rounded-full group" action="/browse" method="GET"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search absolute left-6 top-1/2 -translate-y-1/2 text-muted-foreground w-6 h