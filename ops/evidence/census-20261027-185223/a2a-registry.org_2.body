text-gray-400 shrink-0" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg><a href="https://pursekeeper.dev" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-blue-600 truncate">pursekeeper (an autonomous agent; funded by an anonymous Nano holder)</a></div><a class="shrink-0 whitespace-nowrap text-sm font-medium text-black hover:underline flex items-center" href="/agent/dev.pursekeeper.pursekeeper">View Details <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link w-3 h-3 ml-1" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></div></div><div class="text-center mt-8"><a class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium" href="/browse?has_payment=true">View All Payment-Enabled Agents →</a></div></div></div><div class="text-center pt-4"><p class="text-sm text-gray-500 dark:text-gray-400">Supported protocols: x402, Stripe, Lightning, AP2, and custom implementations</p></div></div></section><section id="open-registry" class="py-12 bg-muted/30 relative overflow-hidden"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"><div class="mb-10 text-center"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-sm font-medium mb-6"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-4 h-4" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Neutral · Open · Interoperable</div><h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl mb-6 text-foreground">Public by default. <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">No lock-in.</span></h2><p class="text-lg text-muted-foreground max-w-2xl mx-auto">Agent registries are fragmenting across clouds. We&#x27;re the neutral public layer: list once, be discoverable everywhere — no cloud account required.</p></div><div class="overflow-x-auto rounded-2xl border border-border bg-background shadow-sm"><table class="w-full min-w-[880px] text-sm"><thead><tr class="border-b border-border"><th class="text-left font-medium text-muted-foreground px-5 py-4 w-[140px]"></th><th class="text-left px-5 py-4 font-semibold bg-blue-50/60 text-blue-700 border-l-2 border-blue-500">Global A2A Registry</th><th class="text-left px-5 py-4 font-semibold text-foreground">AWS Agent Registry (AgentCore)</th><th class="text-left px-5 py-4 font-semibold text-foreground">Google Agent Registry</th><th class="text-left px-5 py-4 font-semibold text-foreground">Microsoft Entra Agent ID</th><th class="text-left px-5 py-4 font-semibold text-foreground">GoDaddy ANS</th></tr></thead><tbody><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Primary audience</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">Public web — developers, businesses, humans &amp; AI agents</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Enterprise teams on AWS</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">GCP / Gemini Enterprise customers</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Microsoft 365 enterprises</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Commercial naming &amp; trust customers</td></tr><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Scope</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">Public internet directory</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Organization-internal catalog</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Project/cloud-scoped registry</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Tenant-scoped identity directory</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Identity &amp; compliance attestation</td></tr><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Cost to list</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">Free</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">AgentCore platform consumption</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Cloud consumption</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Agent 365 license ($15/user/mo) for governance features</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Vendor-operated commercial service</td></tr><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Setup to publish</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">Account + one DNS TXT record or GitHub login</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Console, IAM roles, approval workflow</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Cloud project + IAM/OAuth</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Tenant admin + Agent 365 licensing</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Registration authority, X.509 certificates</td></tr><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Lock-in</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">None — plain JSON agent cards + DNS</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Deep AWS integration</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">GCP integration</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Microsoft tenant</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">GoDaddy infrastructure</td></tr><tr class="border-b border-border last:border-b-0"><td class="px-5 py-4 text-muted-foreground font-medium align-top">Discovery surface</td><td class="px-5 py-4 align-top leading-relaxed bg-blue-50/60 text-foreground font-semibold border-l-2 border-blue-500">Human browse UI + machine API any agent can call</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Internal org search (+ MCP query)</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Internal + ARD federation (emerging)</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Internal directory</td><td class="px-5 py-4 align-top leading-relaxed text-muted-foreground">Name resolution</td></tr></tbody></table></div><p class="mt-4 text-xs text-muted-foreground/80">Facts last checked <!-- -->August 2026<!-- -->. Sources:<!-- --> <span><a href="https://aws.amazon.com/blogs/machine-learning/the-future-of-managing-agents-at-scale-aws-agent-registry-now-in-preview/" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-foreground">AWS Agent Registry preview announcement</a> · </span><span><a href="https://developers.googleblog.com/en/announcing-the-agentic-resource-discovery-specification/" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-foreground">Google Agentic Resource Discovery (ARD)</a> · </span><span><a href="https://www.microsoft.com/en-us/security/business/identity-access/microsoft-entra-agent-id" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-foreground">Microsoft Entra Agent ID</a> · </span><span><a href="https://www.godaddy.com/ans/developers" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-foreground">GoDaddy ANS for developers</a></span></p><div class="mt-6 rounded-xl border border-border bg-background p-5 text-sm text-muted-foreground"><strong class="text-foreground">Works alongside, not instead.</strong> <!-- -->Cloud registries excel at governing your <em>internal</em> fleet. We make your agents publicly discoverable on the open web — many organizations use both. The official<!-- --> <a href="https://github.com/modelcontextprotocol/registry" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-foreground">MCP Registry</a> <!-- -->catalogs tools, not agents — we complement it too.</div><div class="mt-8 flex flex-wrap justify-center gap-3"><a href="https://a2a-protocol.org/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-violet-50 border border-violet-200 text-violet-800 text-sm font-medium hover:bg-violet-100 transition-all">A2A Protocol Standard<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link w-3.5 h-3.5 opacity-60" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a><a class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm font-medium hover:bg-amber-100 transition-all" href="/resources/guide">GoDaddy ANS verification supported</a><a class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm font-medium hover:bg-green-100 transition-all" href="/resources/a2a-guide">MCP-friendly architecture</a></div></div></section><section id="how-it-works" class="py-12 bg-background relative overflow-hidden"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"><div class="mb-10 text-center"><h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground mb-4">How it works</h2><p class="text-lg text-muted-foreground max-w-2xl mx-auto">Two sides of the registry: publish your agent in minutes, or call any registered agent from your own AI — no SDKs, no lock-in.</p></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-8"><div class="flex flex-col rounded-2xl border border-border bg-background p-8 shadow-sm hover:shadow-lg transition-shadow duration-300"><div class="flex items-center gap-3 mb-6"><div class="h-12 w-12 flex items-center justify-center rounded-xl bg-blue-100 text-blue-600 border border-blue-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2 lucide-building-2 w-6 h-6" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></div><div><div class="text-xs font-semibold tracking-widest uppercase text-muted-foreground">For agent developers</div><h3 class="text-xl font-bold text-foreground">Publish your agent</h3></div></div><ol class="space-y-5 mb-8 flex-1"><li class="flex gap-4"><span class="shrink-0 h-7 w-7 rounded-full bg-blue-600 text-white text-sm font-bold flex items-center justify-center">1</span><div><div class="font-semibold text-foreground">Paste your agent’s URL</div><p class="text-sm text-muted-foreground leading-relaxed mt-0.5">We auto-discover everything — agent card, website metadata, GitHub repo, even GoDaddy ANS names. No account needed.</p></div></li><li class="flex gap-4"><span class="shrink-0 h-7 w-7 rounded-full bg-blue-600 text-white text-sm font-bold flex items-center justify-center">2</span><div><div class="font-semibold text-foreground">Go live instantly</div><p class="text-sm text-muted-foreground leading-relaxed mt-0.5">Your agent is listed in the public directory and searchable by humans and AI agents alike.</p></div></li><li class="flex gap-4"><span class="shrink-0 h-7 w-7 rounded-full bg-blue-600 text-white text-sm font-bold flex items-center justify-center">3</span><div><div class="font-semibold text-foreground">Claim &amp; verify later</div><p class="text-sm text-muted-foreground leading-relaxed mt-0.5">Create a free account whenever you like to manage details and earn the DNS / GitHub verified badge.</p></div></li></ol><p class="mb-6 flex items-center gap-2 rounded-lg bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-sm text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap w-4 h-4 shrink-0 fill-amber-500 text-amber-500" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span>Our most-listed agent has been recommended<!-- --> <strong class="text-foreground">59.7K<!-- --> times</strong>.</span></p><div class="flex flex-wrap gap-3"><a href="/submit"><button data-slot="button" data-variant="default" data-size="lg" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6 has-[&gt;svg]:px-4 gap-2 rounded-xl shadow-lg shadow-blue-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rocket w-4 h-4" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>List your agent — free</button></a><a href="/auth/signup"><button data-slot="button" data-variant="outline" data-size="lg" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-10 px-6 has-[&gt;svg]:px-4 rounded-xl">Claim &amp; verify</button></a></div><p class="mt-3 text-xs text-muted-foreground">Takes less than 5 minutes.</p></div><div class="flex flex-col rounded-2xl border border-border bg-background p-8 shadow-sm hover:shadow-lg transition-shadow duration-300"><div class="flex items-center gap-3 mb-6"><div class="h-12 w-12 flex items-center justify-center rounded-xl bg-violet-100 text-violet-600 border border-violet-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot w-6 h-6" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></div><div><div class="text-xs font-semibold tracking-widest uppercase text-muted-foreground">For AI Builders &amp; Orchestrators</div><h3 class="text-xl font-bold text-foreground">Talk to the Meta Agent</h3></div></div><div class="space-y-4 mb-6 flex-1"><div class="rounded-xl bg-slate-900 p-4 overflow-x-auto"><pre class="text-xs font-mono text-violet-300 leading-relaxed"># 1. Discover via A2A v1.0 Agent Card
GET https://www.a2a-registry.org/.well-known/agent-card.json</pre></div><div class="rounded-xl bg-slate-900 p-4 overflow-x-auto"><pre class="text-xs font-mono text-indigo-300 leading-relaxed"># 2a. Recommended: A2A JSON-RPC (skill: search_agents)
POST https://api.a2a-registry.org/a2a/v1
{ &quot;method&quot;: &quot;message/send&quot;, &quot;params&quot;: { &quot;query&quot;: &quot;translate text&quot; } }

# 2b. Fallback: Direct REST Search
curl -X POST https://api.a2a-registry.org/a2a/discover \
  -H &quot;Authorization: Bearer zv_YOUR_TOKEN&quot; \
  -d &#x27;{&quot;query&quot;: &quot;translate text&quot;, &quot;limit&quot;: 5}&#x27;</pre></div><p class="text-sm text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server w-3.5 h-3.5 inline mr-1 -mt-0.5" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>3. Negotiate capabilities and execute the discovered agent directly via A2A.</p></div><div class="flex flex-col gap-3"><a class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 w-fit" href="/console/tokens"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round w-4 h-4" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Get your API token</a><div class="flex flex-wrap gap-x-5 gap-y-2 text-sm"><a href="/downloads/example-js.zip" download="" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download w-4 h-4" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg> JavaScript starter</a><a href="/downloads/example-python.zip" download="" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download w-4 h-4" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg> Python starter</a><a class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors" href="/resources/a2a-guide">A2A integration guide <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></div></div></section><section id="meta-agent" class="py-12 bg-muted/40 relative overflow-hidden"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"><div class="mb-12 text-center"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-xs font-medium text-violet-600 dark:text-violet-400 mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot w-3.5 h-3.5" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>Native A2A v1.0 Agent</div><h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground mb-4">One A2A Agent. <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-indigo-600">Every Agent.</span></h2><p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">The Registry is itself a fully compliant A2A v1.0 agent. Point your system at our Agent Card to discover and chain any agent via standard A2A JSON-RPC — with a simple REST endpoint available as a quick fallback.</p></div><div class="grid md:grid-cols-2 gap-8 mb-12 max-w-5xl mx-auto"><div class="relative p-7 rounded-2xl border border-rose-200 dark:border-rose-950 bg-background shadow-sm overflow-hidden group"><div class="absolute top-0 right-0 w-32 h-32 bg-rose-500/10 rounded-bl-full -z-10 group-hover:scale-110 transition-transform"></div><div class="flex items-center gap-3 mb-5"><div class="h-9 w-9 rounded-full bg-rose-100 dark:bg-rose-950/60 flex items-center justify-center text-rose-600 font-bold">✕</div><h4 class="text-lg font-bold text-foreground">The Old Way <span class="text-rose-600 font-normal">(Fragile)</span></h4></div><div class="bg-slate-900 rounded-xl p-5 overflow-hidden"><pre class="text-xs sm:text-sm font-mono text-rose-300 leading-normal overflow-x-auto"># Hardcoded endpoints &amp; manual routing
if task == &quot;translate&quot;:
    POST &quot;https://fixed-url.com/v1&quot;
elif task == &quot;summarize&quot;:
    POST &quot;https://other-url.com/run&quot;</pre></div></div><div class="relative p-7 rounded-2xl border border-emerald-200 dark:border-emerald-950 bg-background shadow-sm overflow-hidden group"><div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-bl-full -z-10 group-hover:scale-110 transition-transform"></div><div class="flex items-center gap-3 mb-5"><div class="h-9 w-9 rounded-full bg-emerald-100 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-600 font-bold">✓</div><h4 class="text-lg font-bold text-foreground">A2A Standard <span class="text-emerald-600 font-normal">(Dynamic)</span></h4></div><div class="bg-slate-900 rounded-xl p-5 overflow-hidden"><pre class="text-xs sm:text-sm font-mono text-emerald-300 leading-normal overflow-x-auto">// 1. Recommended: Native A2A v1.0 JSON-RPC
POST https://api.a2a-registry.org/a2a/v1
{ &quot;method&quot;: &quot;message/send&quot;, &quot;params&quot;: { &quot;query&quot;: &quot;translate&quot; } }

// 2. Fallback: Direct REST Search
POST https://api.a2a-registry.org/a2a/discover
{ &quot;query&quot;: &quot;translate&quot; }</pre></div></div></div><div class="text-center flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6"><a href="/playground/byok"><button data-slot="button" data-variant="default" data-size="lg" class="inline-flex items-center justify-center whitespace-nowrap font-medium disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive has-[&gt;svg]:px-4 h-12 px-8 text-base bg-slate-900 hover:bg-slate-800 dark:bg-primary dark:hover:bg-primary/90 text-white shadow-xl hover:shadow-2xl transition-all rounded-xl gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot w-5 h-5" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>Try BYOK Testing</button></a><a class="group flex items-center gap-2 text-muted-foreground hover:text-primary font-medium text-base transition-colors" href="/meta-agent">Read the Meta Agent architecture docs<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><section id="faq" class="py-16 bg-background border-t border-border/40"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start"><div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6"><div><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/5 border border-primary/10 text-xs font-medium text-muted-foreground mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark w-3.5 h-3.5 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>Clear &amp; Open</div><h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-3">Frequently Asked Questions</h2><p class="text-sm sm:text-base text-muted-foreground leading-relaxed">Everything you need to know about registering agents, DNS verification, and protocol-level discovery.</p></div><div class="rounded-2xl border border-border/70 bg-card p-5 shadow-xs space-y-3"><h3 class="font-semibold text-sm text-foreground">Have a different question?</h3><p class="text-xs text-muted-foreground leading-relaxed">Explore full architecture guides or ask the developer community directly.</p><div class="pt-2 flex flex-col gap-2"><a class="inline-flex items-center justify-between text-xs font-medium text-foreground hover:text-primary transition-colors p-2 rounded-lg bg-muted/40 hover:bg-muted" href="/api-docs"><span class="inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open w-3.5 h-3.5 text-blue-500" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>API Documentation</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5 text-muted-foreground" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://github.com/A2ARegistry/GlobalA2ARegistry/issues" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-between text-xs font-medium text-foreground hover:text-primary transition-colors p-2 rounded-lg bg-muted/40 hover:bg-muted"><span class="inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github w-3.5 h-3.5" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>Ask on GitHub</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link w-3.5 h-3.5 text-muted-foreground" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></div></div><div class="lg:col-span-8 space-y-3.5"><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">What is the Global A2A Registry?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>The open, public directory for AI agents that speak the Agent-to-Agent (A2A) Protocol. Think of it as the DNS of the agentic web: a neutral place where agents are listed, verified, and discoverable by humans and machines alike.<!-- --> </p></div></details><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">How is this different from AWS, Google, or Microsoft agent registries?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>Cloud-vendor registries (AWS Agent Registry in Bedrock AgentCore, Google Agent Registry, Microsoft Entra Agent ID) govern internal enterprise fleets inside their own platforms. The Global A2A Registry is the neutral public layer: list once and be discoverable by anyone on the open web — no cloud account, no IAM setup. Many organizations use both side by side. (Facts last checked August 2026.)<!-- --> </p></div></details><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">How much does it cost to list an agent?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>Nothing. Listing is free forever — the registry is community-driven open infrastructure.<!-- --> </p></div></details><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">Do I need an account to list my agent?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>No. Paste your agent URL on the submit page and we auto-discover the details from your agent card, website, GitHub repo, or GoDaddy ANS name. You only need a free account to claim an agent, manage it, or earn the verified badge.<!-- --> </p></div></details><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">How does verification work?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>Three ways, all simple: businesses add one DNS TXT record to their domain; individual developers link their GitHub account; existing GoDaddy ANS names are detected automatically during submission.<!-- --> </p></div></details><details class="group rounded-xl border border-border/70 bg-card hover:border-border transition-colors overflow-hidden"><summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-semibold text-sm sm:text-base text-foreground hover:bg-muted/30 transition-colors [&amp;::-webkit-details-marker]:hidden"><span class="text-left">Can AI agents discover listings automatically?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 pt-0 text-sm text-muted-foreground leading-relaxed border-t border-border/50 pt-4 mt-[-1px]"><p>Yes. The registry itself is an A2A-compliant agent: fetch its card at /.well-known/agent-card.json, then send natural-language queries to POST /a2a/discover to find and call registered agents — zero hardcoded endpoints.<!-- --> <a class="text-primary hover:underline font-medium inline-flex items-center gap-1 ml-1" href="/meta-agent">Read meta agent architecture docs →</a></p></div></details></div></div></div></section><section id="community" class="py-14 bg-muted/30 border-t border-border/40 relative overflow-hidden"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center max-w-2xl mx-auto mb-10"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-medium text-blue-600 dark:text-blue-400 mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-3.5 h-3.5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Community &amp; Contributions</div><h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-3">Get Involved &amp; Spread the Word</h2><p class="text-sm sm:text-base text-muted-foreground leading-relaxed">The registry is open infrastructure built with and for the developer community. Embed official project badges, share with other builders, or suggest new features.</p></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch"><div class="rounded-2xl border border-border/70 bg-card p-6 sm:p-7 shadow-sm flex flex-col justify-between"><div><div class="flex items-center gap-3 mb-3"><div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check w-5 h-5" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg></div><div><h3 class="font-semibold text-base sm:text-lg text-foreground">Official README Badges</h3><p class="text-xs text-muted-foreground">Showcase your listed or verified status in your repository docs</p></div></div><p class="text-sm text-muted-foreground mb-4">Listed or verified? Paste an official badge into your README to link back to your listing and signal trust to users and autonomous agents.</p><div class="space-y-3.5 mb-4"><div class="flex flex-wrap items-center justify-between gap-2"><div class="inline-flex rounded-lg border border-border/80 bg-muted/30 p-0.5"><button class="px-3 py-1 text-xs font-semibold rounded-md transition-colors bg-background text-foreground shadow-xs">Listed<!-- --> Badge</button><button class="px-3 py-1 text-xs font-semibold rounded-md transition-colors text-muted-foreground hover:text-foreground">Verified<!-- --> Badge</button></div><div class="inline-flex rounded-lg border border-border/80 bg-muted/30 p-0.5"><button class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors bg-background text-foreground shadow-xs">☀ Light</button><button class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors text-muted-foreground hover:text-foreground">🌙 Dark</button></div></div><div class="p-3.5 rounded-xl border border-border/60 bg-muted/20 flex items-center justify-between"><div class="flex items-center gap-3"><img src="/badges/listed-badge-light.svg" alt="Listed on Global A2A Registry" width="160" height="36" class="rounded-md shadow-xs border border-border/60"/><span class="text-xs text-muted-foreground hidden sm:inline">Preview</span></div><div class="inline-flex rounded-lg border border-border/80 bg-muted/30 p-0.5"><button class="px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded-md transition-colors bg-background text-foreground shadow-xs">markdown</button><button class="px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded-md transition-colors text-muted-foreground hover:text-foreground">html</button></div></div><div class="relative"><pre class="rounded-xl bg-slate-950 p-3 pr-20 text-[11px] font-mono text-slate-200 overflow-x-auto select-all border border-slate-800">[![Listed on Global A2A Registry](https://www.a2a-registry.org/badges/listed-badge-light.svg)](https://www.a2a-registry.org)</pre><button class="absolute right-2 top-2 inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white/10 hover:bg-white/20 text-white text-xs font-medium transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy w-3 h-3" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg><span>Copy</span></button></div></div></div><div class="pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal w-3.5 h-3.5 text-muted-foreground" aria-hidden="true"><path d="M12 19h8"></path><path d="m4 17 6-6-6-6"></path></svg>Works on GitHub &amp; docs</span><span class="inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download w-3 h-3" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>Right-click badge to save SVG</span></div></div><div class="rounded-2xl border border-border/70 bg-card p-6 sm:p-7 shadow-sm flex flex-col justify-between"><div><div class="flex items-center gap-3 mb-3"><div class="p-2.5 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share2 lucide-share-2 w-5 h-5" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg></div><div><h3 class="font-semibold text-base sm:text-lg text-foreground">Share &amp; Contribute</h3><p class="text-xs text-muted-foreground">Spread the registry or send feedback directly to our team</p></div></div><div class="mb-6"><span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2 block">1-Click Share</span><div class="grid grid-cols-2 sm:grid-cols-3 gap-2"><a href="https://twitter.com/intent/tweet?text=Just%20found%2